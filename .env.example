GEMINI_API_KEY="your_primary_gemini_api_key"
GITLAB_PERSONAL_ACCESS_TOKEN="your_gitlab_personal_access_token_with_api_scope"
MONGODB_CONNECTION_STRING="mongodb+srv://<username>:<password>@cluster.mongodb.net/"
ELASTICSEARCH_URL="https://your-deployment.es.us-central1.gcp.elastic.cloud:443"
ELASTICSEARCH_API_KEY="your_elasticsearch_api_key_base64"

# Optional: Fallback Gemini Keys for Auto-Healing / Quota Distribution
GEMINI_API_KEY_2="fallback_key_2"
GEMINI_API_KEY_3="fallback_key_3"
GEMINI_API_KEY_4="fallback_key_4"
